set -euo pipefail
# Plan variant (design §6.4.2, §6.4.4): read-only plan account, -lock=false, no retry.
# The pull request report carries only the build status; the plan stays in the Cloud Build log,
# and this step prints resource addresses and counts only (public repositories, §6.2).
if [ ! -d "${dir}" ]; then
  echo "== ${dir}: stack directory missing; the stack list is declared in bootstrap" >&2
  exit 1
fi
cd "${dir}"
echo "== ${dir}: init (${env_label})"
terraform init -lock=false -input=false -backend-config=state.config -lockfile=readonly
terraform plan -input=false -lock=false -var-file=${tfvars} -out=tfplan > /dev/null
terraform show -json tfplan > tfplan.json
echo "== ${dir}: planned changes"
jq -r '.resource_changes[]? | select(.change.actions != ["no-op"]) | "\(.change.actions | join(",")) \(.address)"' tfplan.json
echo "add=$$(jq '[.resource_changes[]? | select(.change.actions | index("create"))] | length' tfplan.json) change=$$(jq '[.resource_changes[]? | select(.change.actions == ["update"])] | length' tfplan.json) destroy=$$(jq '[.resource_changes[]? | select(.change.actions | index("delete"))] | length' tfplan.json)"
rm -f tfplan tfplan.json
