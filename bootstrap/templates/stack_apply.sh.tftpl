set -euo pipefail
# Steps 1-3 of the generic build for one stack (design §6.4.2), with one immediate retry of
# plan + apply (P6-27, §6.14.3). Rendered by bootstrap; never read from the repository.
if [ ! -d "${dir}" ]; then
  echo "== ${dir}: stack directory missing; the stack list is declared in bootstrap" >&2
  exit 1
fi
cd "${dir}"
echo "== ${dir}: init (${env_label})"
terraform init -input=false -backend-config=state.config -lockfile=readonly
attempt() {
  terraform plan -input=false -var-file=${tfvars} -out=tfplan && terraform apply -input=false -auto-approve tfplan
}
if ! attempt; then
  echo "== ${dir}: first attempt failed; retrying plan and apply once (P6-27)"
  attempt
fi
echo "== ${dir}: applied at $COMMIT_SHA"
